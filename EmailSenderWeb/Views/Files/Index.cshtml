@model IReadOnlyList<EmailSenderWeb.Models.StoredFileItem>
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Files"];
}

<section class="hero">
    <p class="eyebrow">@Localizer["LabEyebrow"]</p>
    <h1>@Localizer["FilesTitle"]</h1>
    <p class="lead">@Localizer["FilesDescription"]</p>
</section>

@if (ViewBag.Notice is string notice)
{
    <div class="alert success" role="status">@Localizer[notice]</div>
}
@if (ViewBag.Error is string error)
{
    <div class="alert failure" role="alert">@Localizer[error]</div>
}

<section class="card upload-card">
    <h2>@Localizer["UploadFile"]</h2>
    <p>@Localizer["UploadDescription"]</p>
    <form asp-controller="Files" asp-action="Upload" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <label for="file">@Localizer["ChooseFile"]</label>
        <input id="file" name="file" type="file" required />
        <button type="submit">@Localizer["Upload"]</button>
    </form>
</section>

<section class="files-section">
    <div class="section-heading">
        <div>
            <h2>@Localizer["SavedFiles"]</h2>
            <p class="lead">@Localizer["TotalFiles", Model.Count]</p>
        </div>
    </div>
    @if (Model.Count == 0)
    {
        <div class="card empty-state">@Localizer["NoFiles"]</div>
    }
    else
    {
        <div class="card table-wrap">
            <table>
                <thead>
                    <tr><th>@Localizer["Name"]</th><th>@Localizer["Size"]</th><th>@Localizer["Added"]</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var file in Model)
                {
                    <tr>
                        <td class="file-name">@file.DisplayName</td>
                        <td>@(file.Length < 1024 ? $"{file.Length} Б" : $"{file.Length / 1024.0:0.##} КБ")</td>
                        <td>@file.UploadedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td><a class="button-link small-button" asp-controller="Files" asp-action="Details" asp-route-name="@file.StoredName">@(file.CanPreview ? Localizer["Preview"] : Localizer["Open"])</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
